[
{{#each licenses}}
  {
    "id": {{{json id}}},
    "name": {{{json name}}},
    "text": {{{json text}}},
    "crates": [
      {{#each used_by}}
      {
        "name": {{{json crate.name}}},
        "version": {{{json crate.version}}},
        "repository": {{#if crate.repository}}{{{json crate.repository}}}{{else}}null{{/if}}
      }{{#unless @last}},{{/unless}}
      {{/each}}
    ]
  }{{#unless @last}},{{/unless}}
{{/each}}
]
